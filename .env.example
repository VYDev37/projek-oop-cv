# ==============================================================================
# KONFIGURASI ENVIRONMENT VARIABLE - TRAFFIC AI SYSTEM
# Salin file ini menjadi '.env' dan isi GEMINI_API_KEY milik Anda.
# ==============================================================================

# Dapatkan API Key gratis di Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Pilihan Model Multimodal: gemini-3.1-flash-lite (default, cepat), gemini-3.6-flash, atau gemini-3.8-flash
GEMINI_MODEL=gemini-3.1-flash-lite

# Model YOLO (default: yolov8n.pt untuk lightweight real-time)
YOLO_MODEL_PATH=yolov8n.pt

# Tracker konfigurasi (bytetrack.yaml atau botsort.yaml)
TRACKER_CONFIG=bytetrack.yaml
